#include <stdio.h>

int main() {
    char name[100];
    char section[50];
    float num1, num2;

    printf("Enter your complete name: ");
    fgets(name, sizeof(name), stdin);

    printf("Enter your section: ");
    fgets(section, sizeof(section), stdin);

    printf("Enter first number: ");
    scanf("%f", &num1);

    printf("Enter second number: ");
    scanf("%f", &num2);

    printf("\n===== STUDENT CALCULATOR =====\n");
    printf("Name: %s", name);
    printf("Section: %s", section);

    printf("\n%.0f + %.0f = %.0f\n", num1, num2, num1 + num2);
    printf("%.0f - %.0f = %.0f\n", num1, num2, num1 - num2);
    printf("%.0f x %.0f = %.0f\n", num1, num2, num1 * num2);

    if (num2 != 0) {
    printf("%.0f / %.0f = %.2f\n", num1, num2, num1 / num2);
    } else {
    printf("%.0f / %.0f = Cannot divide by zero.\n", num1, num2);
    }
    printf("\nPress Enter to exit...");
    getchar();
    getchar();

    return 0;
    
}

