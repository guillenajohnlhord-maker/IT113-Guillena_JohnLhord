#include <stdio.h>

float balance = 500.00;

int displayMenu();
float balanceInquiry();
float deposit();
float withdraw();

int main()
{
    int choice;

    do
    {
        displayMenu();

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                balanceInquiry();
                break;

            case 2:
                deposit();
                break;

            case 3:
                withdraw();
                break;

            case 4:
                printf("\nThank you for using BSIT BANK!\n");
                break;

            default:
                printf("\nInvalid choice! Please try again.\n");
        }

    } while (choice != 4);

    return 0;
}

int displayMenu()
{
    printf("\n==============================\n");
    printf("        BSIT BANK ATM\n");
    printf("==============================\n");
    printf("[1] Balance Inquiry\n");
    printf("[2] Deposit\n");
    printf("[3] Withdraw\n");
    printf("[4] Exit\n");
    printf("==============================\n");

    return 0;
}

float balanceInquiry()
{
    printf("\nCurrent Balance: P%.2f\n", balance);

    return balance;
}

float deposit()
{
    float amount;

    printf("\nEnter amount to deposit: P");
    scanf("%f", &amount);

    if (amount > 0)
    {
        balance = balance + amount;

        printf("\nDeposit successful!\n");
        printf("New Balance: P%.2f\n", balance);
    }
    else
    {
        printf("\nInvalid deposit amount!\n");
    }

    return balance;
}

float withdraw()
{
    float amount;

    printf("\nEnter amount to withdraw: P");
    scanf("%f", &amount);

    if (amount <= 0)
    {
        printf("\nInvalid withdrawal amount!\n");
    }
    else if (balance - amount < 100.00)
    {
        printf("\nWithdrawal denied! You must maintain at least P100.00 in your account\n");
    }
    else
    {
        balance = balance - amount;

        printf("\nWithdrawal successful!\n");
        printf("Remaining Balance: P%.2f\n", balance);
    }

    return balance;
}
